# === Database ===
# URL de conexão assíncrona do banco de dados (asyncpg)
DATABASE_URL=
# URL de conexão síncrona do banco de dados (psycopg2/etc)
DATABASE_URL_SYNC=

# === External APIs ===
# Chave de API do Last.fm
LASTFM_API_KEY=
# Segredo compartilhado do Last.fm
LASTFM_SHARED_SECRET=
# Client ID do Spotify
SPOTIFY_CLIENT_ID=
# Client Secret do Spotify
SPOTIFY_CLIENT_SECRET=
# URL de callback do OAuth Spotify — precisa bater exatamente com uma
# Redirect URI cadastrada no Spotify Developer Dashboard. Em dev local pode
# ficar vazia (cai no fallback http://127.0.0.1:8000/v1/auth/spotify/callback,
# a única forma que o Spotify aceita sem HTTPS). Em produção é obrigatória,
# com HTTPS: https://<seu-backend>/v1/auth/spotify/callback
SPOTIFY_REDIRECT_URI=
# Chave de API da Groq — opcional desde a Fase 4: só melhora a estimativa
# de features acústicas (energy/valence/danceability/acousticness) das
# faixas do Spotify. Sem ela, o catálogo e o gosto do usuário ainda
# funcionam (features caem para um valor neutro). O que decide modo
# real vs. mock é só SPOTIFY_CLIENT_ID/SECRET — ver app/config.py::use_mock.
GROQ_API_KEY=
# Chave de API do Google Gemini (reservada para geração de capas via
# gemini-3-pro-image — ainda não consumida pelo código atual)
GEMINI_API_KEY=

# === Frontend ===
# Origem(ns) do frontend para CORS — uma URL, ou várias separadas por
# vírgula (ex: produção + preview + dev local ao mesmo tempo):
# FRONTEND_ORIGIN=https://the-time-machine.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=
